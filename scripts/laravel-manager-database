#!/usr/bin/python3
"""Narrow, root-owned per-project database provisioner for Ubuntu 24.04."""

from __future__ import annotations

import hashlib
import json
import os
import re
import secrets
import stat
import subprocess
import sys
import tempfile
from pathlib import Path


SETTINGS_FILE = Path("/etc/laravel-manager/database.json")
MYSQL = "/usr/bin/mysql"
PSQL = "/usr/bin/psql"
RUNUSER = "/usr/sbin/runuser"
GIT = "/usr/bin/git"
SAFE_SLUG = re.compile(r"\A[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\Z")
SAFE_DATABASE_NAME = re.compile(r"\A[a-z0-9_]{1,63}\Z")
ENV_KEYS = (
    "DB_CONNECTION",
    "DB_URL",
    "DB_HOST",
    "DB_PORT",
    "DB_SOCKET",
    "DB_DATABASE",
    "DB_USERNAME",
    "DB_PASSWORD",
)


class HelperError(Exception):
    def __init__(self, code: str):
        super().__init__(code)
        self.code = code


def validate_slug(slug: str) -> None:
    if len(slug) > 63 or not SAFE_SLUG.fullmatch(slug):
        raise HelperError("INVALID_PROJECT")


def project_database_names(slug: str) -> tuple[str, str]:
    validate_slug(slug)
    suffix = hashlib.sha256(slug.encode("ascii")).hexdigest()[:8]
    safe_slug = slug.replace("-", "_")
    database_name = f"lm_{safe_slug[:51]}_{suffix}"
    username = f"lm_{safe_slug[:20]}_{suffix}"
    if len(database_name) > 64 or len(username) > 32:
        raise HelperError("INVALID_PROJECT")
    return database_name, username


def require_root(unavailable_code: str) -> None:
    if os.geteuid() != 0:
        raise HelperError(unavailable_code)


def require_root_owned_regular_file(path: Path) -> None:
    try:
        info = path.lstat()
    except OSError as error:
        raise HelperError("MYSQL_UNAVAILABLE") from error

    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise HelperError("MYSQL_UNAVAILABLE")


def load_applications_root(unavailable_code: str = "MYSQL_UNAVAILABLE") -> Path:
    require_root_owned_regular_file(SETTINGS_FILE)
    try:
        settings = json.loads(SETTINGS_FILE.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, ValueError) as error:
        raise HelperError(unavailable_code) from error

    if not isinstance(settings, dict) or set(settings) != {"applications_directory"}:
        raise HelperError(unavailable_code)

    applications_directory = settings.get("applications_directory")
    if not isinstance(applications_directory, str):
        raise HelperError("MYSQL_UNAVAILABLE")

    root = Path(applications_directory)
    if (
        not root.is_absolute()
        or ".." in root.parts
        or str(root) != applications_directory
        or root == Path("/")
        or not root.is_dir()
        or root.resolve(strict=True) != root
    ):
        raise HelperError("MYSQL_UNAVAILABLE")

    return root


def project_environment(slug: str, unavailable_code: str = "MYSQL_UNAVAILABLE") -> tuple[int, str, os.stat_result]:
    root = load_applications_root(unavailable_code)
    directory_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
    root_descriptor = -1
    project_descriptor = -1
    environment_descriptor = -1
    try:
        root_descriptor = os.open(root, directory_flags)
        project_descriptor = os.open(slug, directory_flags, dir_fd=root_descriptor)
        project_info = os.fstat(project_descriptor)
        artisan_info = os.stat("artisan", dir_fd=project_descriptor, follow_symlinks=False)
        environment_descriptor = os.open(
            ".env",
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
            dir_fd=project_descriptor,
        )
        info = os.fstat(environment_descriptor)
    except OSError as error:
        if environment_descriptor >= 0:
            os.close(environment_descriptor)
        if project_descriptor >= 0:
            os.close(project_descriptor)
        raise HelperError("INVALID_PROJECT") from error
    finally:
        if root_descriptor >= 0:
            os.close(root_descriptor)

    if (
        not stat.S_ISDIR(project_info.st_mode)
        or not stat.S_ISREG(artisan_info.st_mode)
        or not stat.S_ISREG(info.st_mode)
        or info.st_size > 262144
        or not info.st_mode & 0o400
        or info.st_mode & 0o077
    ):
        os.close(environment_descriptor)
        os.close(project_descriptor)
        raise HelperError("UNSAFE_ENV")

    try:
        contents = bytearray()
        while len(contents) <= 262144:
            chunk = os.read(environment_descriptor, min(16384, 262145 - len(contents)))
            if not chunk:
                break
            contents.extend(chunk)
        if len(contents) > 262144:
            raise HelperError("UNSAFE_ENV")
        return project_descriptor, contents.decode("utf-8"), info
    except HelperError:
        os.close(project_descriptor)
        raise
    except (OSError, UnicodeError) as error:
        os.close(project_descriptor)
        raise HelperError("UNSAFE_ENV") from error
    finally:
        os.close(environment_descriptor)


def sql_identifier(value: str) -> str:
    if not re.fullmatch(r"[a-z0-9_]{1,64}", value):
        raise HelperError("INVALID_PROJECT")
    return f"`{value}`"


def sql_string(value: str) -> str:
    if not re.fullmatch(r"[a-zA-Z0-9_.-]{1,128}", value):
        raise HelperError("INVALID_PROJECT")
    return "'" + value + "'"


def mysql_environment() -> dict[str, str]:
    return {
        "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
        "HOME": "/root",
        "LANG": "C",
        "LC_ALL": "C",
    }


def postgres_environment() -> dict[str, str]:
    return {
        "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
        "HOME": "/var/lib/postgresql",
        "LANG": "C",
        "LC_ALL": "C",
    }


def require_env_is_ignored(slug: str, unavailable_code: str = "MYSQL_UNAVAILABLE") -> None:
    root = load_applications_root(unavailable_code)
    project = root / slug
    if project.is_symlink() or not project.is_dir() or project.resolve() != project:
        raise HelperError("INVALID_PROJECT")
    try:
        result = subprocess.run(
            [GIT, "--no-pager", "-c", f"safe.directory={project}", "-c", "core.fsmonitor=false", "check-ignore", "--quiet", "--", ".env"],
            cwd=root / slug,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=5,
            env={
                **mysql_environment(),
                "GIT_CONFIG_NOSYSTEM": "1",
                "GIT_CONFIG_GLOBAL": "/dev/null",
                "GIT_TERMINAL_PROMPT": "0",
                "GIT_OPTIONAL_LOCKS": "0",
            },
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise HelperError("GIT_CHECK_FAILED") from error

    if result.returncode == 1:
        raise HelperError("ENV_NOT_IGNORED")
    if result.returncode != 0:
        raise HelperError("GIT_CHECK_FAILED")


def run_admin_sql(sql: str, failure_code: str) -> str:
    try:
        result = subprocess.run(
            [MYSQL, "--no-defaults", "--protocol=socket", "--user=root", "--batch", "--skip-column-names", "--raw"],
            input=sql,
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            encoding="utf-8",
            timeout=12,
            env=mysql_environment(),
        )
    except (OSError, subprocess.TimeoutExpired, UnicodeError) as error:
        raise HelperError("MYSQL_UNAVAILABLE") from error

    if result.returncode != 0:
        raise HelperError(failure_code)

    return result.stdout.strip()


def ensure_database_names_are_available(database_name: str, username: str) -> None:
    query = (
        "SELECT 'database' FROM information_schema.schemata WHERE schema_name = "
        + sql_string(database_name)
        + ";\nSELECT 'user' FROM mysql.user WHERE user = "
        + sql_string(username)
        + " AND host = 'localhost';\n"
    )
    if run_admin_sql(query, "MYSQL_UNAVAILABLE"):
        raise HelperError("DATABASE_EXISTS")


def update_environment(contents: str, values: dict[str, str]) -> str:
    lines = contents.splitlines()
    updated: list[str] = []
    written: set[str] = set()
    assignment = re.compile(r"\A\s*(?:export\s+)?(DB_[A-Z_]+)\s*=")

    for line in lines:
        match = assignment.match(line)
        key = match.group(1) if match else None
        if key in ENV_KEYS:
            if key not in written:
                updated.append(f"{key}={values[key]}")
                written.add(key)
            continue
        updated.append(line)

    for key in ENV_KEYS:
        if key not in written:
            updated.append(f"{key}={values[key]}")

    return "\n".join(updated) + "\n"


def atomic_write_environment(directory_descriptor: int, contents: str, owner: os.stat_result) -> None:
    descriptor = -1
    temporary_name: str | None = None
    try:
        for _ in range(5):
            temporary_name = ".laravel-manager-env-" + secrets.token_hex(12)
            try:
                descriptor = os.open(
                    temporary_name,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
                    0o600,
                    dir_fd=directory_descriptor,
                )
                break
            except FileExistsError:
                temporary_name = None
        if descriptor < 0 or temporary_name is None:
            raise OSError("Could not reserve a temporary environment file.")

        os.fchown(descriptor, owner.st_uid, owner.st_gid)
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as stream:
            descriptor = -1
            stream.write(contents)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary_name, ".env", src_dir_fd=directory_descriptor, dst_dir_fd=directory_descriptor)
        temporary_name = None
        os.fsync(directory_descriptor)
    except OSError as error:
        raise HelperError("UNSAFE_ENV") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary_name is not None:
            try:
                os.unlink(temporary_name, dir_fd=directory_descriptor)
            except OSError:
                pass


def verify_application_connection(database_name: str, username: str, password: str, socket_path: str) -> None:
    descriptor = -1
    options_path: Path | None = None
    try:
        descriptor, name = tempfile.mkstemp(prefix="laravel-manager-mysql-", suffix=".cnf")
        options_path = Path(name)
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            descriptor = -1
            stream.write(
                "[client]\n"
                f"user={username}\n"
                f"password={password}\n"
                f"socket={socket_path}\n"
                "protocol=socket\n"
            )
            stream.flush()
            os.fsync(stream.fileno())

        try:
            result = subprocess.run(
                [
                    MYSQL,
                    f"--defaults-file={options_path}",
                    "--batch",
                    "--skip-column-names",
                    "--raw",
                    f"--database={database_name}",
                    "--execute=SELECT 1",
                ],
                check=False,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                encoding="utf-8",
                timeout=10,
                env=mysql_environment(),
            )
        except (OSError, subprocess.TimeoutExpired, UnicodeError) as error:
            raise HelperError("PROVISION_FAILED") from error

        if result.returncode != 0 or result.stdout.strip() != "1":
            raise HelperError("PROVISION_FAILED")
    except OSError as error:
        raise HelperError("PROVISION_FAILED") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if options_path is not None:
            try:
                options_path.unlink(missing_ok=True)
            except OSError:
                pass


def rollback(database_name: str, username: str, database_created: bool, user_created: bool) -> bool:
    statements = []
    if user_created:
        statements.append(f"DROP USER IF EXISTS {sql_string(username)}@'localhost';")
    if database_created:
        statements.append(f"DROP DATABASE IF EXISTS {sql_identifier(database_name)};")

    if not statements:
        return True

    try:
        run_admin_sql("\n".join(statements) + "\n", "CLEANUP_REQUIRED")
        return True
    except HelperError:
        return False


def run_postgres_admin_sql(sql: str, failure_code: str) -> str:
    try:
        result = subprocess.run(
            [
                RUNUSER,
                "-u",
                "postgres",
                "--",
                PSQL,
                "--no-psqlrc",
                "--set=ON_ERROR_STOP=1",
                "--tuples-only",
                "--no-align",
                "--dbname=postgres",
            ],
            input=sql,
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            encoding="utf-8",
            timeout=12,
            env=postgres_environment(),
        )
    except (OSError, subprocess.TimeoutExpired, UnicodeError) as error:
        raise HelperError("POSTGRESQL_UNAVAILABLE") from error

    if result.returncode != 0:
        raise HelperError(failure_code)

    return result.stdout.strip()


def postgres_identifier(value: str) -> str:
    if not SAFE_DATABASE_NAME.fullmatch(value):
        raise HelperError("INVALID_PROJECT")
    return f'"{value}"'


def postgres_string(value: str) -> str:
    if not re.fullmatch(r"[a-zA-Z0-9_.-]{1,128}", value):
        raise HelperError("INVALID_PROJECT")
    return "'" + value + "'"


def ensure_postgres_names_are_available(database_name: str, username: str) -> None:
    query = (
        "SELECT 'database' FROM pg_database WHERE datname = "
        + postgres_string(database_name)
        + ";\nSELECT 'role' FROM pg_roles WHERE rolname = "
        + postgres_string(username)
        + ";\n"
    )
    if run_postgres_admin_sql(query, "POSTGRESQL_UNAVAILABLE"):
        raise HelperError("DATABASE_EXISTS")


def verify_postgres_application_connection(database_name: str, username: str, password: str) -> None:
    descriptor = -1
    passfile: Path | None = None
    try:
        descriptor, name = tempfile.mkstemp(prefix="laravel-manager-postgres-", suffix=".pgpass")
        passfile = Path(name)
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            descriptor = -1
            stream.write(f"127.0.0.1:5432:{database_name}:{username}:{password}\n")
            stream.flush()
            os.fsync(stream.fileno())

        try:
            result = subprocess.run(
                [
                    PSQL,
                    "--no-psqlrc",
                    "--no-password",
                    "--host=127.0.0.1",
                    "--port=5432",
                    f"--username={username}",
                    f"--dbname={database_name}",
                    "--tuples-only",
                    "--no-align",
                    "--command=SELECT 1",
                ],
                check=False,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                encoding="utf-8",
                timeout=10,
                env={**postgres_environment(), "PGPASSFILE": str(passfile)},
            )
        except (OSError, subprocess.TimeoutExpired, UnicodeError) as error:
            raise HelperError("PROVISION_FAILED") from error

        if result.returncode != 0 or result.stdout.strip() != "1":
            raise HelperError("PROVISION_FAILED")
    except OSError as error:
        raise HelperError("PROVISION_FAILED") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if passfile is not None:
            try:
                passfile.unlink(missing_ok=True)
            except OSError:
                pass


def rollback_postgres(database_name: str, username: str, database_created: bool, role_created: bool) -> bool:
    statements = []
    if database_created:
        statements.append(f"DROP DATABASE IF EXISTS {postgres_identifier(database_name)};")
    if role_created:
        statements.append(f"DROP ROLE IF EXISTS {postgres_identifier(username)};")

    if not statements:
        return True

    try:
        run_postgres_admin_sql("\n".join(statements) + "\n", "CLEANUP_REQUIRED")
        return True
    except HelperError:
        return False


def provision_mysql(slug: str) -> None:
    validate_slug(slug)
    database_name, username = project_database_names(slug)
    database_identifier = sql_identifier(database_name)
    username_sql = sql_string(username)
    directory_descriptor, original_contents, original_stat = project_environment(slug, "MYSQL_UNAVAILABLE")
    try:
        socket_path = run_admin_sql("SELECT @@socket;\n", "MYSQL_UNAVAILABLE")
        if not re.fullmatch(r"/[A-Za-z0-9._/-]{1,254}", socket_path):
            raise HelperError("MYSQL_UNAVAILABLE")

        require_env_is_ignored(slug, "MYSQL_UNAVAILABLE")
        ensure_database_names_are_available(database_name, username)

        database_created = False
        user_created = False
        environment_write_attempted = False
        try:
            run_admin_sql(
                f"CREATE DATABASE {database_identifier} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;\n",
                "PROVISION_FAILED",
            )
            database_created = True

            password = secrets.token_hex(32)
            run_admin_sql(
                f"CREATE USER {username_sql}@'localhost' IDENTIFIED BY {sql_string(password)};\n",
                "PROVISION_FAILED",
            )
            user_created = True

            run_admin_sql(
                f"GRANT ALL PRIVILEGES ON {database_identifier}.* TO {username_sql}@'localhost';\n",
                "PROVISION_FAILED",
            )

            environment = update_environment(original_contents, {
                "DB_CONNECTION": "mysql",
                "DB_URL": "null",
                "DB_HOST": "localhost",
                "DB_PORT": "3306",
                "DB_SOCKET": socket_path,
                "DB_DATABASE": database_name,
                "DB_USERNAME": username,
                "DB_PASSWORD": password,
            })
            environment_write_attempted = True
            atomic_write_environment(directory_descriptor, environment, original_stat)
            verify_application_connection(database_name, username, password, socket_path)
        except HelperError as error:
            environment_restore_failed = False
            if environment_write_attempted:
                try:
                    atomic_write_environment(directory_descriptor, original_contents, original_stat)
                except HelperError:
                    environment_restore_failed = True

            if environment_restore_failed or not rollback(database_name, username, database_created, user_created):
                raise HelperError("CLEANUP_REQUIRED") from error

            raise
    finally:
        os.close(directory_descriptor)


def provision_postgresql(slug: str) -> None:
    validate_slug(slug)
    database_name, username = project_database_names(slug)
    database_identifier = postgres_identifier(database_name)
    username_identifier = postgres_identifier(username)
    directory_descriptor, original_contents, original_stat = project_environment(slug, "POSTGRESQL_UNAVAILABLE")

    try:
        require_env_is_ignored(slug, "POSTGRESQL_UNAVAILABLE")
        ensure_postgres_names_are_available(database_name, username)

        role_created = False
        database_created = False
        environment_write_attempted = False
        try:
            password = secrets.token_hex(32)
            run_postgres_admin_sql(
                "CREATE ROLE " + username_identifier
                + " WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT PASSWORD "
                + postgres_string(password)
                + ";\n",
                "PROVISION_FAILED",
            )
            role_created = True

            run_postgres_admin_sql(
                f"CREATE DATABASE {database_identifier} OWNER {username_identifier} ENCODING 'UTF8';\n",
                "PROVISION_FAILED",
            )
            database_created = True
            run_postgres_admin_sql(
                f"REVOKE ALL ON DATABASE {database_identifier} FROM PUBLIC;\n"
                f"GRANT ALL PRIVILEGES ON DATABASE {database_identifier} TO {username_identifier};\n",
                "PROVISION_FAILED",
            )

            environment = update_environment(original_contents, {
                "DB_CONNECTION": "pgsql",
                "DB_URL": "null",
                "DB_HOST": "127.0.0.1",
                "DB_PORT": "5432",
                "DB_SOCKET": "null",
                "DB_DATABASE": database_name,
                "DB_USERNAME": username,
                "DB_PASSWORD": password,
            })
            environment_write_attempted = True
            atomic_write_environment(directory_descriptor, environment, original_stat)
            verify_postgres_application_connection(database_name, username, password)
        except HelperError as error:
            environment_restore_failed = False
            if environment_write_attempted:
                try:
                    atomic_write_environment(directory_descriptor, original_contents, original_stat)
                except HelperError:
                    environment_restore_failed = True

            if environment_restore_failed or not rollback_postgres(database_name, username, database_created, role_created):
                raise HelperError("CLEANUP_REQUIRED") from error

            raise
    finally:
        os.close(directory_descriptor)


def main(arguments: list[str]) -> int:
    if len(arguments) != 3 or arguments[0] != "provision":
        print("Usage: laravel-manager-database provision <slug> <mysql|pgsql>", file=sys.stderr)
        return 2

    try:
        validate_slug(arguments[1])
        engine = arguments[2]
        if engine not in {"mysql", "pgsql"}:
            raise HelperError("INVALID_PROJECT")

        unavailable_code = "MYSQL_UNAVAILABLE" if engine == "mysql" else "POSTGRESQL_UNAVAILABLE"
        require_root(unavailable_code)
        if engine == "mysql":
            provision_mysql(arguments[1])
        else:
            provision_postgresql(arguments[1])
        print("READY")
        return 0
    except HelperError as error:
        print(f"ERROR: {error.code}", file=sys.stderr)
        return 1
    except OSError:
        print("ERROR: PROVISION_FAILED", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
